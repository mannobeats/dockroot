# Optional local development overrides.
# Dockroot generates its own local secrets and runtime config in `.dockroot/`.

# Set this only if you want local development to behave like a real custom domain.
# APP_URL=http://localhost:3080

# Optional GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
