# Optional production overrides for single-file Docker installs.
# Dockroot generates internal secrets automatically on first boot and stores them in `dockroot_data`.

# Set this when deploying behind a reverse proxy or custom domain.
# APP_URL=https://dockroot.example.com

# Optional GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
