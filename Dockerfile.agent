FROM node:22-alpine AS deps

WORKDIR /app

RUN apk add --no-cache python3 make g++
COPY packages/agent/package.json ./package.json
RUN npm install --omit=dev
COPY packages/agent/src ./src

FROM node:22-alpine

WORKDIR /app

RUN addgroup -S app && adduser -S -D -H -G app app
RUN apk add --no-cache docker-cli docker-cli-compose
RUN mkdir -p /var/lib/dockroot-agent && chown -R app:app /app /var/lib/dockroot-agent

COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/src ./src

ENV NODE_ENV=production
ENV DOCKROOT_AGENT_PORT=9095
ENV DOCKROOT_AGENT_DATA_DIR=/var/lib/dockroot-agent

EXPOSE 9095
USER app

CMD ["node", "/app/src/index.mjs"]
